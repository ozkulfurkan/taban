{
  "expo": {
    "name": "SoleCost",
    "slug": "solecost",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "solecost",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.solecost.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.solecost.app",
      "adaptiveIcon": {
        "backgroundColor": "#6B1A2C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B1A2C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ürün fotoğrafı eklemek için fotoğraflarınıza erişim gerekir.",
          "cameraPermission": "Ürün fotoğrafı çekmek için kamera erişimi gerekir.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulamayı Face ID ile kilitleyip açmak için kullanılır."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://www.solecost.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "60cd8040-90e3-40b3-8aef-8698f033b98a"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ozkulfurkan"
  }
}
